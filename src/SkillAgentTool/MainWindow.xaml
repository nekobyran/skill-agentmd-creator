<Window
    x:Class="SkillAgentTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Skill/agentmd 创建工具">

    <Grid Padding="16">
        <StackPanel Spacing="12">
            <TextBlock Text="Skill / agentmd 创建工具" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="AiEntryText" TextWrapping="Wrap" FontSize="12" Foreground="Gray"/>
            <TextBlock Text="已存在的 skill："/>
            <ListView x:Name="SkillList"
                      Height="360"
                      SelectionMode="None"/>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <Button x:Name="AddButton"
                Content="＋ 添加"
                Width="64"
                Height="64"
                Background="#FF1E88E5"
                Foreground="White"
                CornerRadius="32"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Click="AddButton_Click"/>
    </Grid>
</Window>
